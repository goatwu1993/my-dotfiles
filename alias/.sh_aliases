# takes one argument: the path to the git worktree
gitworktreecd() {
    worktree_name=$1
    #git worktree list | grep "\[${WORKTREE_NAME}\]" | awk '{print $1}'
    cd $(git worktree list | grep "\[${worktree_name}\]" | awk '{print $1}')
}

unalias gwt 2>/dev/null
gwt() {
    local branch="${1:?branch name required}"
    local base="${2:-origin/main}"
    local safe
    safe=$(python3 -c "
import re, sys
s = sys.argv[1].lower()
s = re.sub(r'[^a-z0-9._-]+', '-', s)
s = s.strip('-')
print(s)
" "$branch")
    local dir="$(git rev-parse --show-toplevel)/../${safe}"
    git worktree add "${dir}" -b "${safe}" "${base}" >&2
    echo "${dir}"
  }

killport() {
    lsof -i :$1 -t | xargs kill -9
}

